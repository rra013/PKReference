<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleSpokenName</key>
	<string>P K Reference</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The PK Reference server runs on the owner's machine over plain HTTP while the app isn't deployed. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PK Reference connects to your PK Reference server on this network for tournament data, when it's turned on in Settings.</string>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>P K Reference</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>pee kay reference</string>
		</dict>
	</array>
</dict>
</plist>
