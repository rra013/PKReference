<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Maven's build file: what the project is, what it depends on and how it's built.
    `mvn verify` compiles, runs every test and packages a runnable jar; `mvn spring-boot:run`
    starts the server.

    The parent, spring-boot-starter-parent, sets the Java compiler up and, above all, manages
    versions: most dependencies below give no <version>, because the parent names one for each
    that is known to work with this Spring Boot release.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>com.pkreference</groupId>
  <artifactId>pkreference-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>pkreference-backend</name>
  <description>Kafka + Spring Boot tournament usage pipeline for PK Reference</description>

  <properties>
    <java.version>21</java.version>
    <!-- 1.20, Spring Boot 3.4's, asks Docker for an API version Docker 29 no longer serves. -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <springdoc.version>2.8.6</springdoc.version>
    <nimbus-jose-jwt.version>10.10</nimbus-jose-jwt.version>
  </properties>

  <!--
    A "starter" is a dependency that brings a whole feature: its libraries, and the
    auto-configuration that sets them up from application.yml when the server starts.
  -->
  <dependencies>
    <!-- The web layer: Spring MVC (@RestController), Jackson for JSON, and an embedded Tomcat,
         so the jar is its own web server. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Database access: the connection pool, JdbcTemplate (plain SQL, used by most of the code),
         transactions (@Transactional), and JPA/Hibernate for the two @Entity classes in usage/. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Bean Validation (jakarta.validation). Nothing uses its annotations yet: the settings
         records check themselves in their constructors. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Kafka: the client library, KafkaTemplate to produce, @KafkaListener to consume, and
         KafkaAdmin, which creates the topics Topics.java declares. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- Reads the controllers' annotations and serves the API's description: the OpenAPI document
         at /v3/api-docs and Swagger UI at /swagger-ui.html. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- Signs and verifies the API's access tokens (JWTs): the library Spring Security uses. -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>${nimbus-jose-jwt.version}</version>
    </dependency>
    <!-- The Postgres JDBC driver. "runtime": needed to run, but no code compiles against it. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Flyway runs the SQL files in src/main/resources/db/migration, in order, each once, when
         the server starts, and records which have run. It checksums them: never edit one that
         has been applied, add a new V<n>__name.sql instead. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Tests run the same migrations on an in-memory database. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- JUnit 5, AssertJ, Mockito and Spring's test support (@SpringBootTest, @WebMvcTest,
         @JdbcTest, MockMvc). "test" scope: not in the jar that ships. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @EmbeddedKafka: a real broker inside the test's JVM, for the pipeline tests. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The store's tests also run on real Postgres, where Docker is there (CI has it). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Regulation data lives at the repo root, shared with the iOS app; bundle it. -->
      <resource>
        <directory>..</directory>
        <targetPath>regulations</targetPath>
        <includes>
          <include>champions-*.json</include>
        </includes>
      </resource>
      <resource>
        <directory>../PKReference</directory>
        <targetPath>regulations</targetPath>
        <includes>
          <include>showdown-champions-data.json</include>
          <!-- Species keys: its form noise words (SpeciesVocabulary). -->
          <include>team_search_vocab.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- Packages the code with all its dependencies into one runnable jar (java -jar), and
           provides `mvn spring-boot:run`. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Mockito's Byte Buddy reads class files up to Java 24; this lets the tests mock on newer
               JDKs too (CI runs Java 21). -->
          <argLine>-Dnet.bytebuddy.experimental=true</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
